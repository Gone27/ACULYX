{
  "manifest_version": 3,
  "name": "ACULYX: Header & Cookie Security Checker",
  "short_name": "ACULYX",
  "version": "2.0.0",
  "description": "Passive HTTP security header and cookie analysis with live grading, CSP evaluation, and privacy-preserving audit capabilities.",

  "browser_specific_settings": {
    "gecko": {
      "id": "seccheck@security-checker.local",
      "strict_min_version": "109.0"
    }
  },

  "background": {
    "scripts": ["src/background/index.ts"],
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "ACULYX: Header & Cookie Security Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "tabs",
    "alarms",
    "activeTab",
    "scripting"
  ],

  "optional_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
