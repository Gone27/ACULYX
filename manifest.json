{
  "manifest_version": 3,
  "name": "Header & Cookie Security Checker",
  "short_name": "SecCheck",
  "version": "1.0.0",
  "description": "Passively observes security headers and cookies as you browse. All analysis is local — nothing leaves your device.",

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "action": {
    "default_title": "Security Checker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },

  "sandbox": {
    "pages": ["src/sandbox/poc.html"]
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "webNavigation",
    "tabs",
    "alarms",
    "activeTab",
    "scripting",
    "sidePanel"
  ],

  "optional_host_permissions": ["<all_urls>"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "minimum_chrome_version": "116"
}
