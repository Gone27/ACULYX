export default "{\"manifest_version\":3,\"name\":\"Header & Cookie Security Checker\",\"short_name\":\"SecCheck\",\"version\":\"0.1.0\",\"description\":\"Passively observes security headers and cookies as you browse. All analysis is local — nothing leaves your device.\",\"background\":{\"service_worker\":\"src/background/index.ts\",\"type\":\"module\"},\"content_scripts\":[{\"matches\":[\"<all_urls>\"],\"js\":[\"src/content/service-worker-detection.ts\"],\"run_at\":\"document_start\"}],\"action\":{\"default_popup\":\"src/popup/popup.html\",\"default_title\":\"Security Checker\",\"default_icon\":{\"16\":\"icons/icon16.png\",\"32\":\"icons/icon32.png\",\"48\":\"icons/icon48.png\",\"128\":\"icons/icon128.png\"}},\"options_ui\":{\"page\":\"src/options/options.html\",\"open_in_tab\":true},\"permissions\":[\"storage\",\"cookies\",\"webRequest\",\"webNavigation\",\"tabs\",\"alarms\",\"activeTab\"],\"optional_host_permissions\":[\"<all_urls>\"],\"content_security_policy\":{\"extension_pages\":\"script-src 'self'; object-src 'none'; connect-src 'none'\"},\"icons\":{\"16\":\"icons/icon16.png\",\"32\":\"icons/icon32.png\",\"48\":\"icons/icon48.png\",\"128\":\"icons/icon128.png\"},\"minimum_chrome_version\":\"116\"}"