      "url": "https://example.com/",
      "status": 200,
      "headers": {
        "x-frame-options": "DENY"
      }
    },
    "expectedRuleIds": [],
    "notExpectedRuleIds": ["XFO-001"]
  },
  {
    "description": "x-frame-options: SAMEORIGIN expects no XFO finding",
    "hop": {
      "url": "https://example.com/",
      "status": 200,
      "headers": {
        "x-frame-options": "SAMEORIGIN"
      }
    },
    "expectedRuleIds": [],
    "notExpectedRuleIds": ["XFO-001"]
  },
  {
    "description": "x-frame-options: ALLOWALL (invalid value) expects XFO-001",
    "hop": {
      "url": "https://example.com/",
      "status": 200,
      "headers": {
        "x-frame-options": "ALLOWALL"
      }
    },
    "expectedRuleIds": ["XFO-001"],
    "notExpectedRuleIds": []
