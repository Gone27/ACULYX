      "url": "https://example.com/",
      "status": 200,
      "headers": {
        "content-security-policy": "default-src 'self'; frame-ancestors 'none'"
      }
    },
    "expectedRuleIds": [],
    "notExpectedRuleIds": ["XFO-001"]
  }
